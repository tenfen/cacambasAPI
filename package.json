  "main": "index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "env-cmd -f environments/.env.prd node ./index.js",
    "insert": "env-cmd -f environments/.env.dev node environments/inserirdadosMongo.js",
    "start-local": "env-cmd -f environments/.env.local ./node_modules/nodemon/bin/nodemon.js --inspect ./index.js",
    "start-dev": "env-cmd -f environments/.env.dev node ./index.js",
    "start-prd": "env-cmd -f environments/.env.prd ./node_modules/nodemon/bin/nodemon.js --inspect ./index.js",
    "expo-build-dev-android": "eas build --platform android --profile development",
    "expo-build-dev-ios": "eas build --platform ios --profile development",
    "test": "echo \"Error: no test specified\" && exit 1",
    "watch": "webpack --watch",
    "build": "webpack"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.515.0",
