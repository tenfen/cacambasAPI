    "default-api-response-node": "^1.0.7",
    "dotenv": "^11.0.0",
    "env-cmd": "^10.1.0",
    "expo-dev-client": "^6.0.20",
    "expo-modules": "^0.0.0",
    "expo-server-sdk": "^4.0.0",
    "express": "^4.22.2",
